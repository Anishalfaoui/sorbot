flowchart TB

  subgraph DATA[Data & Feature Layer]
    direction LR
    A[Market Data\nyfinance + Binance]
    B[Data Loader\nfetch_all_timeframes]
    C[Feature Engineering\nbuild_dataset]
  end

  subgraph ML[Model Layer]
    direction LR
    D[Training\nXGBoost walk-forward CV]
    E[Model Registry\nmodels/*.json]
    F[Predictor\nLONG / SHORT + SL/TP]
  end

  subgraph BACKEND[Backend Orchestration]
    direction LR
    G[Fetch Prediction\n/api/predictions/fetch]
    H[Store Prediction\nPENDING or AUTO_EXECUTING]
    I{Decision}
    J[Accept Prediction\n/api/predictions/by-id/accept]
    K[Auto Execution\nScheduler]
    L[Trade Validation\n/api/trade in AI]
    M{Execution Result}
    N[Persist Trade OPEN\nDB: trades]
    O[Update Prediction\nREJECTED / FAILED]
    P[Close Position]
    Q[Persist CLOSED + PnL\nUpdate virtualBalance]
  end

  subgraph UI[Presentation Layer]
    direction TB
    R[Dashboard + Trades + Stats\nREST + WebSocket]
  end

  A --> B --> C --> D --> E
  E --> F
  B --> G
